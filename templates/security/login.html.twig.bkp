<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AssureX – Sign In</title>
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
    <style>
        /* ── Background: frozen home page ── */
        body {
            overflow: hidden;
        }

        .bg-home {
            position: fixed;
            inset: 0;
            z-index: 0;
            background: linear-gradient(135deg, #f4f7fb 60%, #dbe8f8 100%);
            display: flex;
            flex-direction: column;
            pointer-events: none;
            user-select: none;
        }

        /* Fake navbar ghost */
        .bg-home__nav {
            height: 68px;
            background: #1a4f8a;
            display: flex;
            align-items: center;
            padding: 0 2.5rem;
            gap: 0.6rem;
            filter: blur(3px);
        }

        .bg-home__nav-brand {
            color: #fff;
            font-size: 1.35rem;
            font-weight: 700;
            margin-right: auto;
        }

        .bg-home__nav-link {
            color: rgba(255,255,255,0.7);
            font-size: 0.95rem;
            padding: 0.4rem 1rem;
        }

        /* Fake hero ghost */
        .bg-home__hero {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 4rem 2.5rem;
            filter: blur(3px);
        }

        .bg-home__hero-text h1 {
            font-size: 2.8rem;
            font-weight: 800;
            color: #1a4f8a;
            line-height: 1.2;
        }

        .bg-home__hero-text h1 span { color: #e8a020; }

        .bg-home__hero-text p {
            color: #5a6a7e;
            margin-top: 1rem;
            font-size: 1.05rem;
        }

        .bg-home__shield {
            font-size: 9rem;
            opacity: 0.6;
        }

        /* Dark overlay on top of background */
        .overlay {
            position: fixed;
            inset: 0;
            z-index: 1;
            background: rgba(15, 35, 60, 0.55);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }

        /* ── Login card ── */
        .login-wrapper {
            position: fixed;
            inset: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-card {
            background: #fff;
            border-radius: 18px;
            padding: 2.8rem 2.5rem 2.2rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 24px 60px rgba(15, 35, 60, 0.3);
            animation: slideUp 0.35s ease;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .login-card__logo {
            text-align: center;
            margin-bottom: 1.6rem;
        }

        .login-card__logo span {
            font-size: 2.8rem;
        }

        .login-card__logo h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #1a4f8a;
            margin-top: 0.3rem;
        }

        .login-card__logo p {
            font-size: 0.9rem;
            color: #5a6a7e;
            margin-top: 0.2rem;
        }

        /* Error alert */
        .alert-error {
            background: #fef2f2;
            border: 1px solid #fca5a5;
            color: #b91c1c;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Form */
        .form-group {
            margin-bottom: 1.1rem;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #1e2d40;
            margin-bottom: 0.4rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.7rem 1rem;
            border: 1.8px solid #d1dde8;
            border-radius: 8px;
            font-size: 0.95rem;
            color: #1e2d40;
            background: #f8fafc;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }

        .form-group input:focus {
            border-color: #1a4f8a;
            box-shadow: 0 0 0 3px rgba(26,79,138,0.12);
            background: #fff;
        }

        /* Remember me */
        .form-check {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.4rem;
            font-size: 0.88rem;
            color: #5a6a7e;
        }

        .form-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #1a4f8a;
        }

        /* Submit button */
        .btn-login {
            width: 100%;
            padding: 0.8rem;
            background: #1a4f8a;
            color: #fff;
            border: none;
            border-radius: 999px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .btn-login:hover {
            background: #2d72c8;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(26,79,138,0.25);
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin: 1.4rem 0 1rem;
            color: #a0b0c0;
            font-size: 0.82rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2eaf3;
        }

        /* Register link */
        .register-prompt {
            text-align: center;
            font-size: 0.9rem;
            color: #5a6a7e;
        }

        .register-prompt a {
            color: #e8a020;
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s;
        }

        .register-prompt a:hover {
            color: #cf8a10;
            text-decoration: underline;
        }

        /* Back to home link */
        .back-home {
            display: block;
            text-align: center;
            margin-top: 1.2rem;
            font-size: 0.85rem;
            color: #5a6a7e;
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-home:hover { color: #1a4f8a; }

        @media (max-width: 480px) {
            .login-card { padding: 2rem 1.4rem 1.6rem; }
        }
    </style>
</head>
<body>

    <!-- ── Blurred background (fake home snapshot) ── -->
    <div class="bg-home">
        <div class="bg-home__nav">
            <span class="bg-home__nav-brand">🛡️ AssureX</span>
            <span class="bg-home__nav-link">Home</span>
            <span class="bg-home__nav-link">About</span>
            <span class="bg-home__nav-link">Services</span>
            <span class="bg-home__nav-link">Sign In</span>
        </div>
        <div class="bg-home__hero">
            <div class="bg-home__hero-text">
                <h1>Your Peace of Mind,<br><span>Our Priority</span></h1>
                <p>Comprehensive insurance solutions tailored to protect<br>what matters most to you and your family.</p>
            </div>
            <div class="bg-home__shield">🛡️</div>
        </div>
    </div>

    <!-- ── Dark overlay ── -->
    <div class="overlay"></div>

    <!-- ── Login card ── -->
    <div class="login-wrapper">
        <div class="login-card">

            <div class="login-card__logo">
                <span>🛡️</span>
                <h2>Welcome Back</h2>
                <p>Sign in to your AssureX account</p>
            </div>

            {% if error %}
                <div class="alert-error">
                    ⚠️ {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">

                <div class="form-group">
                    <label for="inputEmail">Email address</label>
                    <input type="email"
                           id="inputEmail"
                           name="email"
                           value="{{ last_username }}"
                           autocomplete="email"
                           required
                           autofocus
                           placeholder="you@example.com">
                </div>

                <div class="form-group">
                    <label for="inputPassword">Password</label>
                    <input type="password"
                           id="inputPassword"
                           name="password"
                           autocomplete="current-password"
                           required
                           placeholder="••••••••">
                </div>

                {% if app.user %}
                <div style="font-size:0.85rem; color:#5a6a7e; margin-bottom:0.8rem;">
                    Logged in as {{ app.user.userIdentifier }}.
                    <a href="{{ logout_path() }}" style="color:#e8a020;">Logout</a>
                </div>
                {% endif %}

                <div class="form-check">
                    <input type="checkbox" id="remember_me" name="_remember_me">
                    <label for="remember_me">Remember me</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="divider">or</div>

            <p class="register-prompt">
                New to AssureX?
                <a href="{{ path('app_register') }}">Create an account</a>
            </p>

            <a href="{{ path('app_home') }}" class="back-home">← Back to Home</a>

        </div>
    </div>

</body>
</html>
