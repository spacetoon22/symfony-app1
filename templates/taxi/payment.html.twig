<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AssureX – Payment</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'DM Sans', system-ui, sans-serif;
        background: #f1f5f9;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }
    .page-wrap { width: 100%; max-width: 480px; }

    .brand-bar {
        display: flex; align-items: center; justify-content: center; gap: .6rem;
        padding: 1.25rem; background: #1e40af;
        border-radius: 14px 14px 0 0; color: white;
    }
    .brand-bar .logo { font-size: 1.2rem; font-weight: 800; }
    .brand-bar .logo span { color: #93c5fd; }
    .brand-bar .step-hint { font-size: .8rem; opacity: .75; margin-left: auto; }

    .summary-card { background: #1d4ed8; color: white; padding: 1.4rem 1.75rem; }
    .summary-title { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; opacity: .7; margin-bottom: .85rem; }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem .75rem; }
    .sg-label { font-size: .72rem; opacity: .65; margin-bottom: .15rem; }
    .sg-val { font-size: .92rem; font-weight: 600; }
    .summary-total {
        display: flex; justify-content: space-between; align-items: center;
        border-top: 1px solid rgba(255,255,255,.2);
        margin-top: 1rem; padding-top: .85rem;
    }
    .summary-total .label { font-size: .85rem; opacity: .8; }
    .summary-total .amount { font-size: 1.5rem; font-weight: 800; }

    .pay-body {
        background: white; border-radius: 0 0 14px 14px;
        padding: 1.75rem; box-shadow: 0 8px 32px rgba(0,0,0,.08);
    }

    .method-tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; }
    .tab-btn {
        flex: 1; padding: .6rem .5rem;
        border: 2px solid #e2e8f0; border-radius: 8px;
        background: white; cursor: pointer;
        font-size: .82rem; font-weight: 600; color: #64748b;
        transition: all .2s; display: flex; align-items: center; justify-content: center; gap: .3rem;
    }
    .tab-btn.active { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
    .tab-btn:hover:not(.active) { border-color: #94a3b8; }

    .pay-panel { display: none; }
    .pay-panel.active { display: block; }

    .field { margin-bottom: 1rem; }
    .field label { display: block; font-size: .75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; margin-bottom: .35rem; }
    .field input {
        width: 100%; padding: .65rem .9rem;
        border: 1.5px solid #e2e8f0; border-radius: 8px;
        font-size: .95rem; color: #1e293b; outline: none;
        transition: border-color .2s; font-family: inherit;
    }
    .field input:focus { border-color: #2563eb; }
    .field input::placeholder { color: #cbd5e1; }
    .field-row { display: flex; gap: .75rem; }
    .field-row .field { flex: 1; }

    .card-visual {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        border-radius: 12px; padding: 1.1rem 1.4rem; color: white;
        margin-bottom: 1.25rem; font-family: 'Courier New', monospace;
        position: relative; overflow: hidden;
    }
    .card-visual::before {
        content: ''; position: absolute; top: -25px; right: -25px;
        width: 100px; height: 100px; border-radius: 50%; background: rgba(255,255,255,.07);
    }
    .card-chip { font-size: 1.2rem; margin-bottom: .6rem; }
    .card-number-display { font-size: 1rem; letter-spacing: .2em; margin-bottom: .6rem; opacity: .9; }
    .card-meta { display: flex; justify-content: space-between; font-size: .75rem; opacity: .65; }

    .paypal-panel-inner { text-align: center; padding: 1rem 0 1.5rem; }
    .pp-logo { font-size: 2rem; font-weight: 900; color: #003087; margin-bottom: .4rem; }
    .pp-logo span { color: #009cde; }
    .pp-sub { font-size: .85rem; color: #64748b; margin-bottom: 1.25rem; }

    .cash-panel-inner { text-align: center; padding: 1.25rem 0 1.5rem; }
    .cash-icon { font-size: 2.5rem; margin-bottom: .75rem; }
    .cash-sub { font-size: .9rem; color: #64748b; line-height: 1.5; }

    .btn-pay {
        width: 100%; padding: .85rem;
        background: #2563eb; color: white;
        border: none; border-radius: 10px;
        font-size: .97rem; font-weight: 700;
        cursor: pointer; transition: background .2s, transform .1s;
        margin-top: .25rem; font-family: inherit;
    }
    .btn-pay:hover { background: #1d4ed8; }
    .btn-pay:active { transform: scale(.98); }
    .btn-pay.green { background: #16a34a; }
    .btn-pay.green:hover { background: #15803d; }

    .secure-note {
        text-align: center; font-size: .75rem; color: #94a3b8;
        margin-top: .85rem; display: flex;
        align-items: center; justify-content: center; gap: .3rem;
    }

    /* ── Overlay ── */
    .overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(255,255,255,.95); z-index: 999;
        flex-direction: column; align-items: center; justify-content: center; gap: 1.1rem;
    }
    .overlay.show { display: flex; }
    .spinner {
        width: 52px; height: 52px;
        border: 4px solid #e2e8f0; border-top-color: #2563eb;
        border-radius: 50%; animation: spin .75s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .ov-title { font-size: 1rem; font-weight: 700; color: #1e293b; }
    .ov-sub { font-size: .85rem; color: #64748b; }

    /* ── Success screen (shown after redirect back) ── */
    .success-screen {
        display: none; text-align: center; padding: 2.5rem 1.5rem;
        background: white; border-radius: 0 0 14px 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,.08);
    }
    .success-screen.show { display: block; }
    .success-icon { font-size: 3.5rem; margin-bottom: 1rem; }
    .success-screen h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: .5rem; color: #1e293b; }
    .success-screen p { color: #64748b; font-size: .9rem; margin-bottom: 1.75rem; line-height: 1.6; }
    .btn-download {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .85rem 2rem; background: #16a34a; color: white;
        border-radius: 10px; font-weight: 700; text-decoration: none;
        font-size: .95rem; transition: opacity .2s; margin-bottom: .75rem;
    }
    .btn-download:hover { opacity: .88; }
    .btn-another { display: block; color: #2563eb; font-size: .85rem; text-decoration: none; margin-top: .5rem; }
    .btn-another:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="page-wrap">

    <div class="brand-bar">
        <div class="logo">Assure<span>X</span></div>
        <div class="step-hint">Step 2 of 5 — Payment</div>
    </div>

    {% if paid is defined and paid %}
    {# ── SUCCESS SCREEN — shown after payment confirmed ── #}
    <div class="success-screen show">
        <div class="success-icon">✅</div>
        <h2>Payment Confirmed!</h2>
        <p>
            Insurance for <strong>{{ dossier.firstName }} {{ dossier.lastName }}</strong> is now active.<br>
            Plan: <strong>{{ dossier.plan|capitalize }}</strong> — Valid until <strong>{{ endDate }}</strong><br>
            Total paid: <strong>{{ totalAmount }} MAD</strong>
        </p>
        <a href="{{ path('app_taxi_contract', {id: dossier.id}) }}" class="btn-download">
            📄 Download PDF Contract
        </a>
        <a href="{{ path('app_taxi') }}" class="btn-another">➕ Submit another dossier</a>
    </div>

    {% else %}
    {# ── PAYMENT FORM ── #}

    <div class="summary-card">
        <div class="summary-title">🚖 Taxi Insurance — Order Summary</div>
        <div class="summary-grid">
            <div>
                <div class="sg-label">Client</div>
                <div class="sg-val">{{ dossier.firstName }} {{ dossier.lastName }}</div>
            </div>
            <div>
                <div class="sg-label">Plan</div>
                <div class="sg-val">{{ dossier.plan|capitalize }}</div>
            </div>
            <div>
                <div class="sg-label">Start Date</div>
                <div class="sg-val">{{ dossier.startDate ? dossier.startDate|date('d/m/Y') : '—' }}</div>
            </div>
            <div>
                <div class="sg-label">Expires</div>
                <div class="sg-val" style="color:#fca5a5;">{{ endDate }}</div>
            </div>
            <div>
                <div class="sg-label">Duration</div>
                <div class="sg-val">{{ dossier.durationMonths ?? 12 }} months</div>
            </div>
            <div>
                <div class="sg-label">Monthly</div>
                <div class="sg-val">{{ dossier.premium ?? 0 }} MAD</div>
            </div>
        </div>
        <div class="summary-total">
            <span class="label">Total to pay</span>
            <span class="amount">{{ totalAmount }} MAD</span>
        </div>
    </div>

    <div class="pay-body">

        <div class="method-tabs">
            <button type="button" class="tab-btn {% if dossier.paymentMethod == 'card' or not dossier.paymentMethod %}active{% endif %}" onclick="switchTab('card',this)">💳 Card</button>
            <button type="button" class="tab-btn {% if dossier.paymentMethod == 'paypal' %}active{% endif %}" onclick="switchTab('paypal',this)">🅿 PayPal</button>
            <button type="button" class="tab-btn {% if dossier.paymentMethod == 'cash' %}active{% endif %}" onclick="switchTab('cash',this)">💵 Cash</button>
        </div>

        {# Each panel has its OWN real form pointing directly to confirm route #}

        {# Card panel #}
        <div class="pay-panel {% if dossier.paymentMethod == 'card' or not dossier.paymentMethod %}active{% endif %}" id="panel-card">
            <div class="card-visual">
                <div class="card-chip">▬▬</div>
                <div class="card-number-display" id="cardDisplay">•••• •••• •••• ••••</div>
                <div class="card-meta">
                    <span id="cardNameDisplay">FULL NAME</span>
                    <span id="cardExpDisplay">MM/YY</span>
                </div>
            </div>
            <div class="field">
                <label>Cardholder Name</label>
                <input type="text" placeholder="Karim Benali" oninput="document.getElementById('cardNameDisplay').textContent=this.value.toUpperCase()||'FULL NAME'">
            </div>
            <div class="field">
                <label>Card Number</label>
                <input type="text" placeholder="1234 5678 9012 3456" maxlength="19" oninput="fmtCard(this)">
            </div>
            <div class="field-row">
                <div class="field">
                    <label>Expiry</label>
                    <input type="text" placeholder="MM/YY" maxlength="5" oninput="fmtExp(this)">
                </div>
                <div class="field">
                    <label>CVV</label>
                    <input type="password" placeholder="•••" maxlength="3">
                </div>
            </div>
            <button type="button" class="btn-pay" onclick="pay('card')">🔒 Pay {{ totalAmount }} MAD</button>
        </div>

        {# PayPal panel #}
        <div class="pay-panel {% if dossier.paymentMethod == 'paypal' %}active{% endif %}" id="panel-paypal">
            <div class="paypal-panel-inner">
                <div class="pp-logo">Pay<span>Pal</span></div>
                <div class="pp-sub">Enter your PayPal email to continue</div>
                <div class="field" style="text-align:left;">
                    <label>PayPal Email</label>
                    <input type="email" placeholder="client@paypal.com">
                </div>
            </div>
            <button type="button" class="btn-pay" style="background:#009cde;" onclick="pay('paypal')">🅿 Pay with PayPal — {{ totalAmount }} MAD</button>
        </div>

        {# Cash panel #}
        <div class="pay-panel {% if dossier.paymentMethod == 'cash' %}active{% endif %}" id="panel-cash">
            <div class="cash-panel-inner">
                <div class="cash-icon">💵</div>
                <div class="cash-sub">Client will pay <strong>{{ totalAmount }} MAD</strong> in cash at the agency.<br>Click confirm to record and generate the contract.</div>
            </div>
            <button type="button" class="btn-pay green" onclick="pay('cash')">✅ Confirm Cash — {{ totalAmount }} MAD</button>
        </div>

        <div class="secure-note">🔒 Simulated payment — no real charges</div>
    </div>

    {% endif %}

</div>

{# ── Processing overlay ── #}
<div class="overlay" id="overlay">
    <div class="spinner"></div>
    <div class="ov-title">Processing payment…</div>
    <div class="ov-sub">Please wait, do not close this page</div>
</div>

{# Single hidden form — submitted via JS after delay #}
<form id="confirmForm" method="POST" action="{{ path('app_taxi_confirm_payment', {id: dossier.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('payment_confirm') }}">
    <input type="hidden" name="payment_method" id="payMethodInput" value="card">
</form>

<script>
function switchTab(method, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.pay-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('panel-' + method).classList.add('active');
}

function fmtCard(input) {
    let v = input.value.replace(/\D/g,'').substring(0,16);
    input.value = v.replace(/(.{4})/g,'$1 ').trim();
    document.getElementById('cardDisplay').textContent = v.padEnd(16,'•').replace(/(.{4})/g,'$1 ').trim();
}
function fmtExp(input) {
    let v = input.value.replace(/\D/g,'').substring(0,4);
    if (v.length >= 2) v = v.substring(0,2)+'/'+v.substring(2);
    input.value = v;
    document.getElementById('cardExpDisplay').textContent = v||'MM/YY';
}

function pay(method) {
    document.getElementById('payMethodInput').value = method;
    document.getElementById('overlay').classList.add('show');
    // Wait 2s then actually submit the form
    setTimeout(function() {
        document.getElementById('confirmForm').submit();
    }, 2000);
}
</script>
</body>
</html>
