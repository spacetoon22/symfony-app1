<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AssureX – Health Insurance Registration</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/health2.css') }}">
</head>
<body>

<!-- ═══ SIDEBAR ═══ -->
<aside class="sidebar">
    <div class="sidebar__brand">
        <div class="brand-icon">🛡️</div>
        <div class="brand-text"><h1>Assure<span>X</span></h1><p>Assurance Platform</p></div>
    </div>
    <nav class="sidebar__nav">
        <div class="nav-section-label">Assurances</div>
        <a href="{{ path('app_health') }}" class="nav-item active"><span class="icon">❤️</span> Health Assurance</a>
        <a href="{{ path('app_taxi') }}"   class="nav-item"><span class="icon">🚖</span> Taxi Assurance</a>
        <a href="#"                         class="nav-item"><span class="icon">🏠</span> Home Assurance</a>
        <a href="#"                         class="nav-item"><span class="icon">🚗</span> Auto Assurance</a>
    </nav>
    <div class="sidebar__footer">
        <div class="user-chip">
            <div class="avatar">{% if app.user %}{{ (app.user.userIdentifier ?? 'A')|first|upper }}{% else %}A{% endif %}</div>
            <div class="user-info">
                <p>{{ app.user ? app.user.userIdentifier : 'Agent' }}</p>
                <span>Agent</span>
            </div>
        </div>
    </div>
</aside>

<!-- ═══ MAIN ═══ -->
<div class="main">
    <header class="topbar">
        <div style="margin-left:.5rem;">
            <div class="topbar__title">Health Insurance Registration</div>
            <div class="topbar__company-number">📞 +212 6 55 88 00 01</div>
        </div>
        <button class="theme-toggle" id="themeToggle" title="Toggle theme">🌙</button>
    </header>

    <div class="content">

        {% if submitted is defined and submitted %}
        <!-- ── SUCCESS ── -->
        <div class="success-screen">
            <div class="success-icon">✅</div>
            <h2>Dossier Submitted Successfully!</h2>
            <p>The client's health insurance dossier has been recorded and is now <strong>pending review</strong> by the commercial team.</p>
            <div class="success-steps">
                <div class="ss-step done">
                    <span class="ss-circle">✓</span>
                    <span>Client Info</span>
                </div>
                <div class="ss-line done"></div>
                <div class="ss-step active">
                    <span class="ss-circle">2</span>
                    <span>Commercial Review</span>
                </div>
                <div class="ss-line"></div>
                <div class="ss-step">
                    <span class="ss-circle">3</span>
                    <span>Admin Validation</span>
                </div>
                <div class="ss-line"></div>
                <div class="ss-step">
                    <span class="ss-circle">4</span>
                    <span>Approved</span>
                </div>
            </div>
            <div class="success-actions">
                <a href="{{ path('app_health') }}" class="btn-new">➕ Submit Another Dossier</a>
            </div>
        </div>

        {% else %}

        {% for message in app.flashes('error') %}
            <div class="flash flash-error">⚠️ {{ message }}</div>
        {% endfor %}

        <!-- ── STEPPER ── -->
        <div class="stepper">
            <div class="step active">
                <div class="step-circle">1</div>
                <div class="step-label">Client Info</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">2</div>
                <div class="step-label">Commercial Review</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">3</div>
                <div class="step-label">Admin Validation</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">✓</div>
                <div class="step-label">Approved</div>
            </div>
        </div>

        <form method="post" action="{{ path('app_health') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token"   value="{{ csrf_token('health_registration') }}">
            {# Price set automatically by JS, never editable #}
            <input type="hidden" name="premium"  id="premium_hidden"  value="0">
            <input type="hidden" name="duration_months" id="duration_hidden" value="">

            <div class="form-grid">

                <!-- ── Section 1: Personal Info ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">👤</span>
                        <div><h3>Personal Information</h3><p>Client identity details</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field-row">
                            <div class="field">
                                <label>First Name <span class="req">*</span></label>
                                <input type="text" name="first_name" placeholder="Karim" required>
                            </div>
                            <div class="field">
                                <label>Last Name <span class="req">*</span></label>
                                <input type="text" name="last_name" placeholder="Benali" required>
                            </div>
                        </div>
                        <div class="field">
                            <label>Date of Birth <span class="req">*</span></label>
                            <input type="date" name="dob" required>
                        </div>
                        <div class="field">
                            <label>National ID / CIN <span class="req">*</span></label>
                            <input type="text" name="cin" placeholder="AB123456" required>
                        </div>
                        <div class="field">
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select…</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ── Section 2: Contact ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">📞</span>
                        <div><h3>Contact Details</h3><p>How to reach the client</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field">
                            <label>Email Address <span class="req">*</span></label>
                            <input type="email" name="email" placeholder="client@example.com" required>
                        </div>
                        <div class="field">
                            <label>Phone Number <span class="req">*</span></label>
                            <input type="tel" name="phone" placeholder="+212 6XX XXX XXX" required>
                        </div>
                        <div class="field">
                            <label>City</label>
                            <input type="text" name="city" placeholder="Casablanca">
                        </div>
                        <div class="field">
                            <label>Full Address</label>
                            <textarea name="address" placeholder="Street, district…"></textarea>
                        </div>
                    </div>
                </div>

                <!-- ── Section 3: Health Coverage ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">❤️</span>
                        <div><h3>Health Coverage Details</h3><p>Plan and coverage period</p></div>
                    </div>
                    <div class="section-body">

                        <div class="field-row">
                            <div class="field">
                                <label>Coverage Plan <span class="req">*</span></label>
                                <select name="plan" id="plan_select" required onchange="onPlanChange(this.value)">
                                    <option value="">Select plan…</option>
                                    <option value="basic">Basic — 3 months / 300 MAD</option>
                                    <option value="standard">Standard — 6 months / 546 MAD</option>
                                    <option value="premium">Premium — 12 months / 1020 MAD</option>
                                    
                                </select>
                            </div>
                            <div class="field">
                                <label>Start Date <span class="req">*</span></label>
                                <input type="date" name="start_date" id="start_date" required onchange="recalculate()">
                            </div>
                        </div>

                        <!-- Plan cards — READ ONLY, highlighted by selection -->
                        <div class="field">
                            <label>Coverage Duration &amp; Price</label>
                            <div id="duration-display">
                                <div class="dur-card-display" id="dc-basic">
                                    <div class="dur-box-ro">
                                        <span class="dur-num">3</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">300 MAD</span>
                                        <span class="dur-plan-tag">Basic</span>
                                    </div>
                                </div>
                                <div class="dur-card-display" id="dc-standard">
                                    <div class="dur-box-ro">
                                        <span class="dur-badge">Popular</span>
                                        <span class="dur-num">6</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">
                                            <span style="text-decoration:line-through;color:#94a3b8;font-size:.8rem;">600</span>
                                            546 MAD
                                        </span>
                                        <span class="dur-plan-tag">Standard −9%</span>
                                    </div>
                                </div>
                                <div class="dur-card-display" id="dc-premium">
                                    <div class="dur-box-ro">
                                        <span class="dur-badge best">Best value</span>
                                        <span class="dur-num">12</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">
                                            <span style="text-decoration:line-through;color:#94a3b8;font-size:.8rem;">1200</span>
                                            1020 MAD
                                        </span>
                                        <span class="dur-plan-tag">Premium −15%</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Live summary — appears once plan + start date are both set -->
                        <div id="coverage-summary" style="display:none;" class="coverage-summary-box">
                            <div class="cs-row">
                                <span>📅 Start</span>
                                <strong id="cs-start">—</strong>
                            </div>
                            <div class="cs-divider"></div>
                            <div class="cs-row">
                                <span>🏁 Expires</span>
                                <strong id="cs-end" style="color:#f87171;">—</strong>
                            </div>
                            <div class="cs-divider"></div>
                            <div class="cs-row">
                                <span>💰 Total</span>
                                <strong id="cs-total" style="color:var(--gold);">— MAD</strong>
                            </div>
                        </div>

                        <!-- Extra health fields -->
                        <div class="field-row">
                            <div class="field">
                                <label>Number of Beneficiaries</label>
                                <input type="number" name="beneficiaries" min="1" max="20" placeholder="1">
                            </div>
                            <div class="field">
                                <label>Pre-existing Conditions</label>
                                <select name="conditions">
                                    <option value="none">None</option>
                                    <option value="diabetes">Diabetes</option>
                                    <option value="hypertension">Hypertension</option>
                                    <option value="cardiac">Cardiac</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="field">
                            <label>Medical Notes</label>
                            <textarea name="medical_notes" placeholder="Any relevant medical history or notes…"></textarea>
                        </div>

                    </div>
                </div>

                <!-- ── Section 4: Commercial Assignment ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">👔</span>
                        <div><h3>Assign to Commercial</h3><p>The commercial who handled this call</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field">
                            <label>Commercial Email <span class="req">*</span></label>
                            <input type="email" name="commercial_email" placeholder="commercial@assurex.ma" required>
                            <small>Enter the email of the commercial this client spoke with.</small>
                        </div>
                    </div>
                </div>

            </div>{# /form-grid #}

            <div class="submit-row">
                <a href="{{ path('app_dashboard') }}" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">💳 Continue to Payment →</button>
            </div>

        </form>

        {% endif %}

    </div>{# /content #}
</div>{# /main #}

<script>
    /* ── Theme ── */
    const toggle = document.getElementById('themeToggle');
    if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); toggle.textContent = '☀️'; }
    toggle.addEventListener('click', () => {
        document.body.classList.toggle('light-mode');
        const isLight = document.body.classList.contains('light-mode');
        toggle.textContent = isLight ? '☀️' : '🌙';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });

    /* ── Plan config — same structure as taxi PLAN_CONFIG ── */
    const PLAN_CONFIG = {
        basic:    { months: 6,  total: 2100,  monthly: 350,  cardId: 'dc-basic'    },
        standard: { months: 6,  total: 3600,  monthly: 600,  cardId: 'dc-standard' },
        premium:  { months: 12, total: 11400, monthly: 950,  cardId: 'dc-premium'  },
        family:   { months: 12, total: 16800, monthly: 1400, cardId: 'dc-family'   },
    };

    const ALL_CARDS = ['dc-basic', 'dc-standard', 'dc-premium', 'dc-family'];

    function onPlanChange(plan) {
        /* Reset all cards to dim — same logic as taxi */
        ALL_CARDS.forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.classList.remove('dc-active'); el.classList.add('dc-dim'); }
        });

        if (!plan || !PLAN_CONFIG[plan]) return;

        const cfg = PLAN_CONFIG[plan];

        /* Highlight selected card */
        const activeEl = document.getElementById(cfg.cardId);
        if (activeEl) { activeEl.classList.remove('dc-dim'); activeEl.classList.add('dc-active'); }

        /* Set hidden fields — same as taxi */
        document.getElementById('duration_hidden').value = cfg.months;
        document.getElementById('premium_hidden').value  = cfg.monthly;

        recalculate();
    }

    function recalculate() {
        const plan     = document.getElementById('plan_select').value;
        const startVal = document.getElementById('start_date').value;
        if (!plan || !startVal || !PLAN_CONFIG[plan]) return;

        const cfg    = PLAN_CONFIG[plan];
        const months = cfg.months;

        /* End date — same calculation as taxi */
        const end = new Date(startVal);
        end.setMonth(end.getMonth() + months);
        end.setDate(end.getDate() - 1);

        const fmt   = d => d.toLocaleDateString('fr-MA', { day:'2-digit', month:'2-digit', year:'numeric' });
        const start = new Date(startVal);

        document.getElementById('cs-start').textContent = fmt(start);
        document.getElementById('cs-end').textContent   = fmt(end);
        document.getElementById('cs-total').textContent = cfg.total.toLocaleString('fr-MA') + ' MAD';
        document.getElementById('coverage-summary').style.display = 'flex';
    }
</script>
</body>
</html>
