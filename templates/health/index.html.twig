<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AssureX – Health Insurance Registration</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
    /* ═══════════════════════════════════════
       TOKENS
    ═══════════════════════════════════════ */
    :root {
        --bg:          #0d1b2a;
        --surface:     #0f2035;
        --surface2:    #132840;
        --border:      rgba(201,168,76,.18);
        --border-soft: rgba(255,255,255,.06);
        --gold:        #c9a84c;
        --gold-dim:    rgba(201,168,76,.12);
        --gold-glow:   rgba(201,168,76,.25);
        --text:        #f0f4ff;
        --text-muted:  #8892b0;
        --slate:       #ccd6f6;
        --red:         #f87171;
        --green:       #2dd4bf;
        --sidebar-w:   240px;
        --radius:      14px;
        --shadow:      0 8px 32px rgba(0,0,0,.45);
    }
    body.light-mode {
        --bg:          #f0f4f8;
        --surface:     #ffffff;
        --surface2:    #f7f9fc;
        --border:      rgba(201,168,76,.25);
        --border-soft: #e2e8f0;
        --text:        #1a202c;
        --text-muted:  #64748b;
        --slate:       #2d3748;
        --shadow:      0 4px 24px rgba(0,0,0,.1);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
        transition: background .3s, color .3s;
    }
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(201,168,76,.2); border-radius: 10px; }

    /* ═══ SIDEBAR ═══ */
    .sidebar {
        width: var(--sidebar-w);
        background: var(--surface);
        border-right: 1px solid var(--border);
        display: flex; flex-direction: column;
        position: fixed; top: 0; left: 0; bottom: 0;
        z-index: 100; transition: background .3s;
    }
    .sidebar__brand {
        display: flex; align-items: center; gap: .75rem;
        padding: 1.4rem 1.2rem 1.1rem;
        border-bottom: 1px solid var(--border);
    }
    .brand-icon { font-size: 1.5rem; }
    .brand-text h1 { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--text); line-height: 1; }
    .brand-text h1 span { color: var(--gold); }
    .brand-text p { font-size: .68rem; color: var(--text-muted); margin-top: .18rem; letter-spacing: .04em; }
    .sidebar__nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
    .nav-section-label {
        font-size: .62rem; font-weight: 600; letter-spacing: .1em;
        text-transform: uppercase; color: var(--text-muted);
        padding: .6rem 1.2rem .35rem; opacity: .7;
    }
    .nav-item {
        display: flex; align-items: center; gap: .65rem;
        padding: .55rem 1.2rem; font-size: .83rem; font-weight: 500;
        color: var(--text-muted); text-decoration: none;
        border-radius: 8px; margin: .1rem .6rem;
        transition: background .15s, color .15s; position: relative;
    }
    .nav-item:hover { background: var(--gold-dim); color: var(--text); }
    .nav-item.active { background: var(--gold-dim); color: var(--gold); font-weight: 600; }
    .nav-item.active::before {
        content: ''; position: absolute; left: -6px; top: 20%; bottom: 20%;
        width: 3px; background: var(--gold); border-radius: 0 3px 3px 0;
    }
    .nav-item .icon { font-size: .95rem; }
    .sidebar__footer { padding: 1rem 1.2rem; border-top: 1px solid var(--border); }
    .user-chip {
        display: flex; align-items: center; gap: .65rem;
        padding: .55rem .7rem; background: var(--gold-dim);
        border-radius: 10px; border: 1px solid var(--border);
    }
    .avatar {
        width: 30px; height: 30px; border-radius: 50%;
        background: linear-gradient(135deg, var(--gold), #7a5c1e);
        color: #0d1b2a; font-weight: 700; font-size: .78rem;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .user-info p { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.2; }
    .user-info span { font-size: .66rem; color: var(--text-muted); }

    /* ═══ MAIN ═══ */
    .main { margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column; min-height: 100vh; }

    /* ═══ TOPBAR ═══ */
    .topbar {
        height: 60px; background: var(--surface);
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; padding: 0 1.75rem; gap: 1rem;
        position: sticky; top: 0; z-index: 50;
    }
    .topbar__title { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--text); }
    .topbar__company-number { font-size: .78rem; color: var(--text-muted); }
    .theme-toggle {
        margin-left: auto;
        width: 34px; height: 34px; border-radius: 8px;
        background: var(--gold-dim); border: 1px solid var(--border);
        color: var(--gold); font-size: .95rem; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: background .15s;
    }
    .theme-toggle:hover { background: var(--gold-glow); }

    /* ═══ CONTENT ═══ */
    .content { padding: 1.75rem; max-width: 1100px; width: 100%; }

    .flash { padding: .75rem 1rem; border-radius: 10px; font-size: .85rem; margin-bottom: 1.25rem; }
    .flash-error { background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.25); color: var(--red); }

    /* ═══ STEPPER ═══ */
    .stepper {
        display: flex; align-items: center;
        margin-bottom: 2rem; background: var(--surface);
        border: 1px solid var(--border); border-radius: var(--radius);
        padding: 1.1rem 1.5rem; overflow-x: auto; gap: 0;
    }
    .step { display: flex; flex-direction: column; align-items: center; gap: .35rem; flex-shrink: 0; }
    .step-circle {
        width: 32px; height: 32px; border-radius: 50%;
        border: 2px solid var(--border-soft); color: var(--text-muted);
        font-size: .78rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        background: var(--surface2); transition: all .3s;
    }
    .step.active .step-circle {
        background: var(--gold); border-color: var(--gold);
        color: #0d1b2a; box-shadow: 0 0 0 4px var(--gold-glow);
    }
    .step-label { font-size: .7rem; font-weight: 500; color: var(--text-muted); white-space: nowrap; }
    .step.active .step-label { color: var(--gold); font-weight: 600; }
    .step-line { flex: 1; height: 1px; background: var(--border); min-width: 40px; margin-bottom: 1.25rem; }

    /* ═══ FORM GRID ═══ */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

    /* ═══ SECTION CARD ═══ */
    .form-section {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); overflow: hidden;
        box-shadow: var(--shadow); transition: background .3s, border-color .3s;
    }
    .section-head {
        display: flex; align-items: flex-start; gap: .85rem;
        padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);
        background: var(--gold-dim);
    }
    .s-icon { font-size: 1.25rem; flex-shrink: 0; margin-top: .05rem; }
    .section-head h3 { font-family: 'Playfair Display', serif; font-size: .95rem; color: var(--text); line-height: 1.2; }
    .section-head p { font-size: .73rem; color: var(--text-muted); margin-top: .2rem; }
    .section-body { padding: 1.25rem; display: flex; flex-direction: column; gap: .85rem; }

    /* ═══ FIELDS ═══ */
    .field { display: flex; flex-direction: column; gap: .35rem; }
    .field label { font-size: .77rem; font-weight: 600; color: var(--slate); letter-spacing: .02em; }
    .req { color: var(--red); }
    .field input, .field select, .field textarea {
        background: var(--surface2); border: 1px solid var(--border-soft);
        border-radius: 9px; padding: .62rem .85rem;
        font-family: 'DM Sans', sans-serif; font-size: .84rem;
        color: var(--text); width: 100%;
        transition: border-color .2s, box-shadow .2s, background .3s;
        outline: none; appearance: none;
    }
    .field input::placeholder, .field textarea::placeholder { color: var(--text-muted); opacity: .65; }
    .field input:focus, .field select:focus, .field textarea:focus {
        border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-glow); background: var(--surface);
    }
    .field textarea { resize: vertical; min-height: 80px; }
    .field select { cursor: pointer; }
    .field small { font-size: .73rem; color: var(--text-muted); margin-top: .15rem; display: block; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }

    /* ═══ DURATION CARDS — exact taxi style ═══ */
    #duration-display { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }

    .dur-card-display { flex-shrink: 0; }
    .dur-box-ro {
        display: flex; flex-direction: column; align-items: center; gap: .2rem;
        padding: .85rem 1.1rem; border-radius: 10px; min-width: 95px;
        background: var(--surface2); border: 1.5px solid var(--border-soft);
        position: relative; text-align: center;
        transition: border-color .25s, background .25s, box-shadow .25s;
    }
    .dc-active .dur-box-ro {
        border-color: var(--gold); background: var(--gold-dim);
        box-shadow: 0 0 0 3px var(--gold-glow);
    }
    .dc-dim .dur-box-ro { opacity: .38; }

    .dur-badge {
        position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
        background: var(--gold); color: #0d1b2a;
        font-size: .6rem; font-weight: 700; padding: .15rem .55rem;
        border-radius: 20px; white-space: nowrap; letter-spacing: .03em;
    }
    .dur-badge.best { background: var(--green); color: #0d1b2a; }

    .dur-num {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem; color: var(--text); line-height: 1;
    }
    .dur-label  { font-size: .7rem; color: var(--text-muted); }
    .dur-price-ro { font-size: .8rem; font-weight: 700; color: var(--gold); margin-top: .15rem; }
    .dur-plan-tag { font-size: .66rem; color: var(--text-muted); margin-top: .1rem; }

    /* ═══ COVERAGE SUMMARY BOX — exact taxi style ═══ */
    .coverage-summary-box {
        display: flex; align-items: center; flex-wrap: wrap; gap: .5rem;
        background: var(--surface2); border: 1px solid var(--border);
        border-radius: 10px; padding: .85rem 1rem; margin-top: .25rem;
    }
    .cs-row { display: flex; flex-direction: column; gap: .2rem; flex: 1; min-width: 80px; }
    .cs-row span { font-size: .72rem; color: var(--text-muted); }
    .cs-row strong { font-size: .9rem; color: var(--text); font-weight: 600; }
    .cs-divider { width: 1px; height: 32px; background: var(--border); flex-shrink: 0; }

    /* ═══ SUBMIT ROW ═══ */
    .submit-row {
        grid-column: 1 / -1;
        display: flex; justify-content: flex-end; align-items: center;
        gap: .85rem; padding: 1rem 0 .25rem;
    }
    .btn-cancel {
        padding: .62rem 1.3rem; border-radius: 9px;
        font-family: 'DM Sans', sans-serif; font-size: .84rem; font-weight: 500;
        color: var(--text-muted); background: var(--surface);
        border: 1px solid var(--border); text-decoration: none;
        transition: background .15s, color .15s; cursor: pointer;
    }
    .btn-cancel:hover { background: var(--surface2); color: var(--text); }
    .btn-submit {
        padding: .65rem 1.5rem; border-radius: 9px;
        font-family: 'DM Sans', sans-serif; font-size: .84rem; font-weight: 600;
        color: #0d1b2a; background: linear-gradient(135deg, var(--gold), #a8852d);
        border: none; cursor: pointer;
        box-shadow: 0 4px 18px rgba(201,168,76,.35);
        transition: opacity .2s, transform .1s, box-shadow .2s;
    }
    .btn-submit:hover { opacity: .92; transform: translateY(-1px); box-shadow: 0 6px 24px rgba(201,168,76,.45); }
    .btn-submit:active { transform: translateY(0); }

    /* ═══ SUCCESS SCREEN ═══ */
    .success-screen {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 2.5rem 2rem;
        text-align: center; box-shadow: var(--shadow);
        max-width: 620px; margin: 0 auto;
        animation: fadeUp .35s ease;
    }
    @keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:none; } }
    .success-icon { font-size: 3rem; margin-bottom: 1rem; }
    .success-screen h2 { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--text); margin-bottom: .6rem; }
    .success-screen > p { font-size: .88rem; color: var(--text-muted); margin-bottom: 2rem; line-height: 1.6; }
    .success-screen > p strong { color: var(--gold); }
    .success-steps {
        display: flex; align-items: center; justify-content: center;
        gap: 0; margin-bottom: 2rem; overflow-x: auto;
    }
    .ss-step { display: flex; flex-direction: column; align-items: center; gap: .3rem; flex-shrink: 0; }
    .ss-circle {
        width: 34px; height: 34px; border-radius: 50%;
        background: var(--surface2); border: 2px solid var(--border);
        color: var(--text-muted); font-size: .78rem; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
    }
    .ss-step.done .ss-circle  { background: var(--gold-dim); border-color: var(--gold); color: var(--gold); }
    .ss-step.active .ss-circle { background: var(--gold); border-color: var(--gold); color: #0d1b2a; box-shadow: 0 0 0 4px var(--gold-glow); }
    .ss-step span:last-child { font-size: .68rem; color: var(--text-muted); white-space: nowrap; }
    .ss-step.done span:last-child, .ss-step.active span:last-child { color: var(--gold); font-weight: 600; }
    .ss-line { flex: 1; height: 1px; background: var(--border); min-width: 30px; margin-bottom: 1.3rem; }
    .ss-line.done { background: var(--gold); }
    .success-actions { display: flex; gap: .85rem; justify-content: center; }
    .btn-new {
        padding: .65rem 1.4rem; border-radius: 9px;
        font-family: 'DM Sans', sans-serif; font-size: .84rem; font-weight: 600;
        color: #0d1b2a; background: linear-gradient(135deg, var(--gold), #a8852d);
        border: none; text-decoration: none; cursor: pointer;
        box-shadow: 0 4px 18px rgba(201,168,76,.3); transition: opacity .2s;
        display: inline-flex; align-items: center; gap: .4rem;
    }
    .btn-new:hover { opacity: .88; }
    </style>
</head>
<body>

<!-- ═══ SIDEBAR ═══ -->
<aside class="sidebar">
    <div class="sidebar__brand">
        <div class="brand-icon">🛡️</div>
        <div class="brand-text"><h1>Assure<span>X</span></h1><p>Assurance Platform</p></div>
    </div>
    <nav class="sidebar__nav">
        <div class="nav-section-label">Assurances</div>
        <a href="{{ path('app_health') }}" class="nav-item active"><span class="icon">❤️</span> Health Assurance</a>
        <a href="{{ path('app_taxi') }}"   class="nav-item"><span class="icon">🚖</span> Taxi Assurance</a>
        <a href="#"                         class="nav-item"><span class="icon">🏠</span> Home Assurance</a>
        <a href="#"                         class="nav-item"><span class="icon">🚗</span> Auto Assurance</a>
    </nav>
    <div class="sidebar__footer">
        <div class="user-chip">
            <div class="avatar">{% if app.user %}{{ (app.user.userIdentifier ?? 'A')|first|upper }}{% else %}A{% endif %}</div>
            <div class="user-info">
                <p>{{ app.user ? app.user.userIdentifier : 'Agent' }}</p>
                <span>Agent</span>
            </div>
        </div>
    </div>
</aside>

<!-- ═══ MAIN ═══ -->
<div class="main">
    <header class="topbar">
        <div style="margin-left:.5rem;">
            <div class="topbar__title">Health Insurance Registration</div>
            <div class="topbar__company-number">📞 +212 6 55 88 00 01</div>
        </div>
        <button class="theme-toggle" id="themeToggle" title="Toggle theme">🌙</button>
    </header>

    <div class="content">

        {% if submitted is defined and submitted %}
        <!-- ── SUCCESS ── -->
        <div class="success-screen">
            <div class="success-icon">✅</div>
            <h2>Dossier Submitted Successfully!</h2>
            <p>The client's health insurance dossier has been recorded and is now <strong>pending review</strong> by the commercial team.</p>
            <div class="success-steps">
                <div class="ss-step done">
                    <span class="ss-circle">✓</span>
                    <span>Client Info</span>
                </div>
                <div class="ss-line done"></div>
                <div class="ss-step active">
                    <span class="ss-circle">2</span>
                    <span>Commercial Review</span>
                </div>
                <div class="ss-line"></div>
                <div class="ss-step">
                    <span class="ss-circle">3</span>
                    <span>Admin Validation</span>
                </div>
                <div class="ss-line"></div>
                <div class="ss-step">
                    <span class="ss-circle">4</span>
                    <span>Approved</span>
                </div>
            </div>
            <div class="success-actions">
                <a href="{{ path('app_health') }}" class="btn-new">➕ Submit Another Dossier</a>
            </div>
        </div>

        {% else %}

        {% for message in app.flashes('error') %}
            <div class="flash flash-error">⚠️ {{ message }}</div>
        {% endfor %}

        <!-- ── STEPPER ── -->
        <div class="stepper">
            <div class="step active">
                <div class="step-circle">1</div>
                <div class="step-label">Client Info</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">2</div>
                <div class="step-label">Commercial Review</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">3</div>
                <div class="step-label">Admin Validation</div>
            </div>
            <div class="step-line"></div>
            <div class="step">
                <div class="step-circle">✓</div>
                <div class="step-label">Approved</div>
            </div>
        </div>

        <form method="post" action="{{ path('app_health') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token"   value="{{ csrf_token('health_registration') }}">
            {# Price set automatically by JS, never editable #}
            <input type="hidden" name="premium"  id="premium_hidden"  value="0">
            <input type="hidden" name="duration_months" id="duration_hidden" value="">

            <div class="form-grid">

                <!-- ── Section 1: Personal Info ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">👤</span>
                        <div><h3>Personal Information</h3><p>Client identity details</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field-row">
                            <div class="field">
                                <label>First Name <span class="req">*</span></label>
                                <input type="text" name="first_name" placeholder="Karim" required>
                            </div>
                            <div class="field">
                                <label>Last Name <span class="req">*</span></label>
                                <input type="text" name="last_name" placeholder="Benali" required>
                            </div>
                        </div>
                        <div class="field">
                            <label>Date of Birth <span class="req">*</span></label>
                            <input type="date" name="dob" required>
                        </div>
                        <div class="field">
                            <label>National ID / CIN <span class="req">*</span></label>
                            <input type="text" name="cin" placeholder="AB123456" required>
                        </div>
                        <div class="field">
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select…</option>
                                <option value="male">Male</option>
                                <option value="female">Female</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ── Section 2: Contact ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">📞</span>
                        <div><h3>Contact Details</h3><p>How to reach the client</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field">
                            <label>Email Address <span class="req">*</span></label>
                            <input type="email" name="email" placeholder="client@example.com" required>
                        </div>
                        <div class="field">
                            <label>Phone Number <span class="req">*</span></label>
                            <input type="tel" name="phone" placeholder="+212 6XX XXX XXX" required>
                        </div>
                        <div class="field">
                            <label>City</label>
                            <input type="text" name="city" placeholder="Casablanca">
                        </div>
                        <div class="field">
                            <label>Full Address</label>
                            <textarea name="address" placeholder="Street, district…"></textarea>
                        </div>
                    </div>
                </div>

                <!-- ── Section 3: Health Coverage ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">❤️</span>
                        <div><h3>Health Coverage Details</h3><p>Plan and coverage period</p></div>
                    </div>
                    <div class="section-body">

                        <div class="field-row">
                            <div class="field">
                                <label>Coverage Plan <span class="req">*</span></label>
                                <select name="plan" id="plan_select" required onchange="onPlanChange(this.value)">
                                    <option value="">Select plan…</option>
                                    <option value="basic">Basic — 6 months / 2 100 MAD</option>
                                    <option value="standard">Standard — 6 months / 3 600 MAD</option>
                                    <option value="premium">Premium — 12 months / 11 400 MAD</option>
                                    <option value="family">Family — 12 months / 16 800 MAD</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Start Date <span class="req">*</span></label>
                                <input type="date" name="start_date" id="start_date" required onchange="recalculate()">
                            </div>
                        </div>

                        <!-- Plan cards — READ ONLY, highlighted by selection -->
                        <div class="field">
                            <label>Coverage Duration &amp; Price</label>
                            <div id="duration-display">
                                <div class="dur-card-display" id="dc-basic">
                                    <div class="dur-box-ro">
                                        <span class="dur-num">6</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">2 100 MAD</span>
                                        <span class="dur-plan-tag">Basic · 350/mo</span>
                                    </div>
                                </div>
                                <div class="dur-card-display" id="dc-standard">
                                    <div class="dur-box-ro">
                                        <span class="dur-badge">Popular</span>
                                        <span class="dur-num">6</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">3 600 MAD</span>
                                        <span class="dur-plan-tag">Standard · 600/mo</span>
                                    </div>
                                </div>
                                <div class="dur-card-display" id="dc-premium">
                                    <div class="dur-box-ro">
                                        <span class="dur-badge best">Best value</span>
                                        <span class="dur-num">12</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">
                                            <span style="text-decoration:line-through;color:#94a3b8;font-size:.75rem;">12 000</span>
                                            11 400 MAD
                                        </span>
                                        <span class="dur-plan-tag">Premium −5%</span>
                                    </div>
                                </div>
                                <div class="dur-card-display" id="dc-family">
                                    <div class="dur-box-ro">
                                        <span class="dur-num">12</span>
                                        <span class="dur-label">months</span>
                                        <span class="dur-price-ro">16 800 MAD</span>
                                        <span class="dur-plan-tag">Family · 1 400/mo</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Live summary — appears once plan + start date are both set -->
                        <div id="coverage-summary" style="display:none;" class="coverage-summary-box">
                            <div class="cs-row">
                                <span>📅 Start</span>
                                <strong id="cs-start">—</strong>
                            </div>
                            <div class="cs-divider"></div>
                            <div class="cs-row">
                                <span>🏁 Expires</span>
                                <strong id="cs-end" style="color:#f87171;">—</strong>
                            </div>
                            <div class="cs-divider"></div>
                            <div class="cs-row">
                                <span>💰 Total</span>
                                <strong id="cs-total" style="color:var(--gold);">— MAD</strong>
                            </div>
                        </div>

                        <!-- Extra health fields -->
                        <div class="field-row">
                            <div class="field">
                                <label>Number of Beneficiaries</label>
                                <input type="number" name="beneficiaries" min="1" max="20" placeholder="1">
                            </div>
                            <div class="field">
                                <label>Pre-existing Conditions</label>
                                <select name="conditions">
                                    <option value="none">None</option>
                                    <option value="diabetes">Diabetes</option>
                                    <option value="hypertension">Hypertension</option>
                                    <option value="cardiac">Cardiac</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="field">
                            <label>Medical Notes</label>
                            <textarea name="medical_notes" placeholder="Any relevant medical history or notes…"></textarea>
                        </div>

                    </div>
                </div>

                <!-- ── Section 4: Commercial Assignment ── -->
                <div class="form-section">
                    <div class="section-head">
                        <span class="s-icon">👔</span>
                        <div><h3>Assign to Commercial</h3><p>The commercial who handled this call</p></div>
                    </div>
                    <div class="section-body">
                        <div class="field">
                            <label>Commercial Email <span class="req">*</span></label>
                            <input type="email" name="commercial_email" placeholder="commercial@assurex.ma" required>
                            <small>Enter the email of the commercial this client spoke with.</small>
                        </div>
                    </div>
                </div>

            </div>{# /form-grid #}

            <div class="submit-row">
                <a href="{{ path('app_dashboard') }}" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">💳 Continue to Payment →</button>
            </div>

        </form>

        {% endif %}

    </div>{# /content #}
</div>{# /main #}

<script>
    /* ── Theme ── */
    const toggle = document.getElementById('themeToggle');
    if (localStorage.getItem('theme') === 'light') { document.body.classList.add('light-mode'); toggle.textContent = '☀️'; }
    toggle.addEventListener('click', () => {
        document.body.classList.toggle('light-mode');
        const isLight = document.body.classList.contains('light-mode');
        toggle.textContent = isLight ? '☀️' : '🌙';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });

    /* ── Plan config — same structure as taxi PLAN_CONFIG ── */
    const PLAN_CONFIG = {
        basic:    { months: 6,  total: 2100,  monthly: 350,  cardId: 'dc-basic'    },
        standard: { months: 6,  total: 3600,  monthly: 600,  cardId: 'dc-standard' },
        premium:  { months: 12, total: 11400, monthly: 950,  cardId: 'dc-premium'  },
        family:   { months: 12, total: 16800, monthly: 1400, cardId: 'dc-family'   },
    };

    const ALL_CARDS = ['dc-basic', 'dc-standard', 'dc-premium', 'dc-family'];

    function onPlanChange(plan) {
        /* Reset all cards to dim — same logic as taxi */
        ALL_CARDS.forEach(id => {
            const el = document.getElementById(id);
            if (el) { el.classList.remove('dc-active'); el.classList.add('dc-dim'); }
        });

        if (!plan || !PLAN_CONFIG[plan]) return;

        const cfg = PLAN_CONFIG[plan];

        /* Highlight selected card */
        const activeEl = document.getElementById(cfg.cardId);
        if (activeEl) { activeEl.classList.remove('dc-dim'); activeEl.classList.add('dc-active'); }

        /* Set hidden fields — same as taxi */
        document.getElementById('duration_hidden').value = cfg.months;
        document.getElementById('premium_hidden').value  = cfg.monthly;

        recalculate();
    }

    function recalculate() {
        const plan     = document.getElementById('plan_select').value;
        const startVal = document.getElementById('start_date').value;
        if (!plan || !startVal || !PLAN_CONFIG[plan]) return;

        const cfg    = PLAN_CONFIG[plan];
        const months = cfg.months;

        /* End date — same calculation as taxi */
        const end = new Date(startVal);
        end.setMonth(end.getMonth() + months);
        end.setDate(end.getDate() - 1);

        const fmt   = d => d.toLocaleDateString('fr-MA', { day:'2-digit', month:'2-digit', year:'numeric' });
        const start = new Date(startVal);

        document.getElementById('cs-start').textContent = fmt(start);
        document.getElementById('cs-end').textContent   = fmt(end);
        document.getElementById('cs-total').textContent = cfg.total.toLocaleString('fr-MA') + ' MAD';
        document.getElementById('coverage-summary').style.display = 'flex';
    }
</script>
</body>
</html>
